# Build stage
ARG PYTHON_VERSION
FROM python:${PYTHON_VERSION} AS builder

USER root

# Copy requirements
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Runtime stage
ARG PYTHON_VERSION
FROM python:${PYTHON_VERSION} AS runtime

USER root

# Install Java 17 (required for Spark, compatible with PySpark 3.5.0)
RUN apt-get update && \
    apt-get install -y openjdk-17-jre-headless && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Copy installed dependencies from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

# Copy application code
COPY src /app/src

# Set working directory
WORKDIR /app

# Set proper permissions
RUN chmod -R 755 /app/src

# Create data directories
RUN mkdir -p /app/data/raw /app/data/processed /app/logs \
    && chmod -R 777 /app/data /app/logs

# Set Spark configuration
ENV SPARK_MASTER="local[*]" \
    SPARK_DRIVER_MEMORY="2g" \
    SPARK_EXECUTOR_MEMORY="2g" \
    SPARK_WORKER_MEMORY="2g" \
    SPARK_WORKER_CORES="2" \
    SPARK_DRIVER_CORES="2" \
    PYTHONPATH="/app:$PYTHONPATH"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ps aux | grep "[p]ython.*processor.py" || exit 1

# Command to run the processor
CMD ["python", "src/data_processing/processor.py"] 